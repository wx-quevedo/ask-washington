# Development-only values. Copy to .env and adjust if needed. Never commit .env.

# Used by docker-compose.yml to create the local database container.
POSTGRES_USER=askw
POSTGRES_PASSWORD=askw_dev
POSTGRES_DB=ask_washington
POSTGRES_PORT=5432

# Used by the app.
DATABASE_URL=postgresql://askw:askw_dev@localhost:5432/ask_washington
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Answers (P18.3). LLM_PROVIDER: only "anthropic" is implemented for now.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
LLM_MAX_TOKENS=600
# Leave empty: Claude Haiku 5.5 rejects non-default temperature values.
LLM_TEMPERATURE=
RETRIEVAL_TOP_K=6
# vector | hybrid | rerank | rerank_light. hybrid = vector + Postgres full text fused with RRF (best quality/latency in P18.4).
RETRIEVAL_MODE=hybrid
# Candidates per search before fusion or reranking, and the cross-encoder used by "rerank".
RETRIEVAL_CANDIDATES=20
# Hybrid mode: at most this many chunks per document among the RETRIEVAL_TOP_K (0 = no limit).
RETRIEVAL_MAX_PER_DOC=3
RERANKER_MODEL=BAAI/bge-reranker-base

# USD per million tokens (Claude Haiku 5.5 list price), used for the daily budget.
LLM_PRICE_INPUT_PER_MTOK=0.10
LLM_PRICE_OUTPUT_PER_MTOK=0.50
DAILY_BUDGET_USD=1.00

# Per-IP rate limits (slowapi syntax) and the salt for the IP hash stored in qa_log.
RATE_LIMIT_PER_MINUTE=10/minute
RATE_LIMIT_PER_DAY=100/day
IP_HASH_SALT=change-me

# Peers allowed to set X-Forwarded-For (IPs or CIDRs): only the local reverse proxy.
FORWARDED_ALLOW_IPS=127.0.0.1

# Origins allowed to embed the page as a widget and send it postMessage events (comma-separated).
EMBED_ALLOWED_ORIGINS=
